#!/bin/sh
set -eu

# Runtime owns this cache. Core and Cloud may supply real state later through a
# versioned agent boundary; this skeleton never infers protocol state.
state_dir=${CANDY_SDWAN_STATE_DIR:-/var/lib/candy/sdwan}
run_dir=${CANDY_SDWAN_RUN_DIR:-/run/candy}
config_file=${CANDY_SDWAN_CONFIG_CACHE:-$state_dir/config-v1.json}
durable_status_file=${CANDY_SDWAN_STATUS_CACHE:-$state_dir/status-v1.json}
published_status_file=${CANDY_SDWAN_STATUS_FILE:-$run_dir/sdwan-status.json}
reconcile_marker=${CANDY_SDWAN_RECONCILE_MARKER:-$state_dir/reconcile-target-v1}
activation_receipt=${CANDY_SDWAN_ACTIVATION_READY:-$state_dir/activation-ready-v1.json}
event_log=${CANDY_SDWAN_EVENT_LOG:-$state_dir/events-v1.log}
max_bootstrap_bytes=${CANDY_SDWAN_MAX_BOOTSTRAP_BYTES:-16384}
max_cloud_bytes=${CANDY_SDWAN_MAX_CLOUD_BYTES:-2048}
if [ -n "${CANDY_CLOUD_ENROLL_CLIENT:-}" ]; then
	enrollment_client=$CANDY_CLOUD_ENROLL_CLIENT
elif [ -x /usr/libexec/candy-cloud-enroll ]; then
	enrollment_client=/usr/libexec/candy-cloud-enroll
else
	enrollment_client=/usr/local/libexec/candy-cloud-enroll
fi
if [ -n "${CANDY_CLOUD_ENROLL_PLATFORM:-}" ]; then
	enrollment_platform=$CANDY_CLOUD_ENROLL_PLATFORM
elif [ -f /etc/openwrt_release ]; then
	enrollment_platform=OPEN_WRT
else
	enrollment_platform=LINUX
fi
case "$(uname -m 2>/dev/null || true)" in
	x86_64) enrollment_architecture=x86_64 ;;
	aarch64|arm64) enrollment_architecture=aarch64 ;;
	armv7*) enrollment_architecture=armv7 ;;
	*) enrollment_architecture= ;;
esac
enrollment_dir=${CANDY_SDWAN_ENROLLMENT_DIR:-$state_dir/identity}
state_user=${CANDY_SDWAN_SERVICE_USER:-candy-sdwan}
state_group=${CANDY_SDWAN_SERVICE_GROUP:-$state_user}
cloud_sync_init=${CANDY_CLOUD_SYNC_INIT:-/etc/init.d/candy-cloud-sync}

fail() {
	printf '%s\n' "candy: $*" >&2
	exit 1
}

require_root() {
	[ "${CANDY_SDWAN_TEST_MODE:-0}" != 1 ] || return 0
	[ "$(id -u)" = 0 ] || fail "this operation requires root privileges"
}

json_string() {
	LC_ALL=C awk 'BEGIN { ORS="" }
	{
		if (NR > 1) printf "\\n"
		gsub(/\\/, "\\\\")
		gsub(/"/, "\\\"")
		gsub(/\t/, "\\t")
		gsub(/\r/, "\\r")
		printf "%s", $0
	}' <<EOF
$1
EOF
}

audit_event() {
	local audit_action=$1 audit_outcome=$2 audit_detail=$3 updated_at temporary
	updated_at=$(date +%s 2>/dev/null || printf 0)
	if [ -f "$event_log" ] && [ ! -L "$event_log" ] && [ "$(wc -c <"$event_log" | tr -d ' ')" -gt 131072 ]; then
		temporary=$(mktemp "$state_dir/.candy-sdwan-events.XXXXXX") || return 1
		tail -n 128 "$event_log" >"$temporary" || { rm -f "$temporary"; return 1; }
		chmod 0600 "$temporary" || { rm -f "$temporary"; return 1; }
		mv -f "$temporary" "$event_log" || { rm -f "$temporary"; return 1; }
	fi
	printf '{"schema_version":1,"updated_at":%s,"action":"%s","outcome":"%s","detail":"%s"}\n' \
		"$updated_at" "$(json_string "$audit_action")" "$(json_string "$audit_outcome")" "$(json_string "$audit_detail")" >>"$event_log" || return 1
	chmod 0600 "$event_log" || return 1
	if [ "${CANDY_SDWAN_TEST_MODE:-0}" != 1 ] && command -v logger >/dev/null 2>&1; then
		logger -t candy -- "level=info event=sdwan_lifecycle action=$audit_action outcome=$audit_outcome detail=$audit_detail"
	fi
}

ensure_directories() {
	umask 077
	[ ! -L "$state_dir" ] || fail "SD-WAN state directory must not be a symbolic link"
	mkdir -p "$state_dir" "$run_dir"
	chmod 0700 "$state_dir"
	chmod 0755 "$run_dir"
}

delegate_state() {
	[ "${CANDY_SDWAN_TEST_MODE:-0}" != 1 ] || return 0
	[ "$(id -u)" = 0 ] || return 0
	id "$state_user" >/dev/null 2>&1 || fail "SD-WAN service user does not exist: $state_user"
	[ -d "$state_dir" ] && [ ! -L "$state_dir" ] || fail "SD-WAN state directory is invalid"
	find "$state_dir" -xdev -type d -exec chmod 0700 {} \; || fail "could not protect SD-WAN state directories"
	find "$state_dir" -xdev -type f -exec chmod 0600 {} \; || fail "could not protect SD-WAN state files"
	find "$state_dir" -xdev ! -type l -exec chown "$state_user:$state_group" {} \; ||
		fail "could not delegate SD-WAN state to $state_user"
}

clear_state_path() {
	path=$1
	if [ -L "$path" ] || [ -f "$path" ]; then
		rm -f "$path"
	elif [ -d "$path" ]; then
		# OpenWrt ships BusyBox find, which does not provide GNU -delete or
		# -mindepth. The paths passed here are fixed SD-WAN-owned paths and
		# the symlink case is handled above, so recursive rm is portable and
		# cannot escape through a state-directory symlink.
		rm -rf "$path"
	elif [ -e "$path" ]; then
		fail "unsupported SD-WAN state object: $path"
	fi
}

clear_enrollment_material() {
	[ -d "$enrollment_dir" ] && [ ! -L "$enrollment_dir" ] || return 0
	for path in "$enrollment_dir"/*; do
		[ -e "$path" ] || [ -L "$path" ] || continue
		case "${path##*/}" in
			installation-instance-id) continue ;;
		esac
		[ -f "$path" ] || [ -L "$path" ] || fail "unsupported enrollment state object: $path"
		rm -f "$path" || fail "could not remove enrollment material: $path"
	done
}

atomic_from_stdin() {
	target=$1
	mode=$2
	directory=${target%/*}
	temporary=$(mktemp "$directory/.candy-sdwan.XXXXXX") || return 1
	trap 'rm -f "$temporary"' EXIT HUP INT TERM
	if ! cat >"$temporary" || ! chmod "$mode" "$temporary" || ! mv -f "$temporary" "$target"; then
		rm -f "$temporary"
		trap - EXIT HUP INT TERM
		return 1
	fi
	trap - EXIT HUP INT TERM
}

atomic_copy() {
	source=$1
	target=$2
	mode=$3
	atomic_from_stdin "$target" "$mode" <"$source"
}

validate_cloud_address() {
	cloud=$1
	length=$(printf '%s' "$cloud" | wc -c | tr -d ' ')
	[ "$length" -gt 0 ] && [ "$length" -le "$max_cloud_bytes" ] ||
		fail "Cloud address must be between 1 and $max_cloud_bytes bytes"
	case "$cloud" in
		https://*) ;;
		*) fail "Cloud address must use https://" ;;
	esac
	case "$cloud" in
		*' '*|*'\t'*|*'\r'*|*'\n'*|*'\\'*|*'"'*) fail "Cloud address contains an invalid character" ;;
	esac
	authority=${cloud#https://}
	authority=${authority%%/*}
	[ -n "$authority" ] || fail "Cloud address is missing a host"
	case "$authority" in *@*) fail "Cloud address must not contain user information" ;; esac
}

validate_bootstrap_file() {
	bootstrap_input=$1
	[ -f "$bootstrap_input" ] && [ ! -L "$bootstrap_input" ] ||
		fail "bootstrap input must be a regular file"
	bytes=$(wc -c <"$bootstrap_input" | tr -d ' ')
	[ "$bytes" -gt 0 ] && [ "$bytes" -le "$max_bootstrap_bytes" ] ||
		fail "bootstrap input must be between 1 and $max_bootstrap_bytes bytes"
}

write_config() {
	cloud=$1
	join_state=$2
	requested_at=$(date +%s)
	cloud_json=$(json_string "$cloud")
	identity_json=null
	if [ "$join_state" = registered ] && [ -f "$enrollment_dir/device-identity-v1.json" ] && [ ! -L "$enrollment_dir/device-identity-v1.json" ]; then
		identity_json=$(cat "$enrollment_dir/device-identity-v1.json")
	fi
	atomic_from_stdin "$config_file" 0600 <<EOF
{"schema_version":1,"cloud_address":"$cloud_json","join_state":"$join_state","requested_at":$requested_at,"identity":$identity_json}
EOF
}

read_cloud() {
	[ -f "$config_file" ] && [ ! -L "$config_file" ] || return 1
	bytes=$(wc -c <"$config_file" | tr -d ' ')
	[ "$bytes" -le 8192 ] || return 1
	sed -n 's/^.*"cloud_address":"\([^"\\]*\)".*$/\1/p' "$config_file"
}

write_status() {
	registration_state=$1
	runtime_state=$2
	reason=${3:-}
	updated_at=$(date +%s)
	cloud=
	if [ "$registration_state" != unregistered ]; then
		cloud=$(read_cloud 2>/dev/null || true)
		[ -n "$cloud" ] || registration_state=unregistered
	fi
	cloud_json=$(json_string "$cloud")
	reason_json=$(json_string "$reason")
	status_tmp=$(mktemp "$state_dir/.candy-sdwan-status.XXXXXX") || return 1
	trap 'rm -f "$status_tmp"' EXIT HUP INT TERM
	cat >"$status_tmp" <<EOF
{"schema_version":1,"registration":{"state":"$registration_state","cloud_address":"$cloud_json","last_error":""},"runtime":{"state":"$runtime_state","updated_at":$updated_at,"last_error":"$reason_json"},"site":null,"segment":null,"tun":{"state":"unavailable","full_duplex":null},"peers":[],"path":null,"egress":{"local":null,"remote":null},"dns":{"state":"unavailable"}}
EOF
	chmod 0600 "$status_tmp"
	mv -f "$status_tmp" "$durable_status_file"
	trap - EXIT HUP INT TERM
	atomic_copy "$durable_status_file" "$published_status_file" 0644
}

current_registration_state() {
	if cloud=$(read_cloud 2>/dev/null) && [ -n "$cloud" ]; then
		if grep -q '"join_state":"registered"' "$config_file" &&
			[ -f "$enrollment_dir/device-identity-v1.json" ] &&
			[ -f "$enrollment_dir/operational-key.pem" ] &&
			[ -f "$enrollment_dir/device-cert.pem" ]; then
			printf '%s\n' registered
		else
			printf '%s\n' join-pending
		fi
	else
		printf '%s\n' unregistered
	fi
}

publish_status() {
	ensure_directories
	if [ -f "$durable_status_file" ] && [ ! -L "$durable_status_file" ]; then
		bytes=$(wc -c <"$durable_status_file" | tr -d ' ')
		if [ "$bytes" -gt 0 ] && [ "$bytes" -le 65536 ] &&
			grep -q '^{"schema_version":1,' "$durable_status_file"; then
			atomic_copy "$durable_status_file" "$published_status_file" 0644
			return
		fi
	fi
	write_status "$(current_registration_state)" stopped ""
}

show_status() {
	for candidate in "$published_status_file" "$durable_status_file"; do
		if [ -f "$candidate" ] && [ ! -L "$candidate" ] && [ -r "$candidate" ]; then
			bytes=$(wc -c <"$candidate" | tr -d ' ')
			if [ "$bytes" -gt 0 ] && [ "$bytes" -le 65536 ] && grep -q '^{"schema_version":1,' "$candidate"; then
				cat "$candidate"
				return
			fi
		fi
	done
	printf '%s\n' '{"schema_version":1,"registration":{"state":"unregistered","cloud_address":"","last_error":""},"runtime":{"state":"unavailable","updated_at":null,"last_error":""},"site":null,"segment":null,"tun":{"state":"unavailable","full_duplex":null},"peers":[],"path":null,"egress":{"local":null,"remote":null},"dns":{"state":"unavailable"}}'
}

read_reconcile_marker() {
	[ -f "$reconcile_marker" ] && [ ! -L "$reconcile_marker" ] || return 1
	bytes=$(wc -c <"$reconcile_marker" | tr -d ' ')
	[ "$bytes" -gt 0 ] && [ "$bytes" -le 256 ] || return 1
	cat "$reconcile_marker"
}

candidate_reconcile_state() {
	if [ -L "$state_dir/candidate" ]; then
		target=$(readlink "$state_dir/candidate" 2>/dev/null || true)
		case "$target" in
			activations/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]* )
				activation_id=${target#activations/}
				case "$activation_id" in
					*[!0-9a-f]*|'') printf '%s\n' invalid ;;
					*)
						if [ "${#activation_id}" -ne 64 ]; then
							printf '%s\n' invalid
						elif [ ! -d "$state_dir/$target" ] || [ -L "$state_dir/$target" ]; then
							printf '%s\n' invalid
						elif [ -f "$activation_receipt" ] && [ ! -L "$activation_receipt" ] &&
							[ "$(wc -c <"$activation_receipt" | tr -d ' ')" -le 65536 ] &&
							grep -F "\"activation_id\":\"$activation_id\"" "$activation_receipt" >/dev/null 2>&1 &&
							grep -F '"state":"rejected"' "$activation_receipt" >/dev/null 2>&1; then
							printf 'rejected:%s\n' "$target"
						else
							printf '%s\n' "$target"
						fi
						;;
				esac
				;;
			*) printf '%s\n' invalid ;;
		esac
		return
	fi
	[ -e "$state_dir/candidate" ] && printf '%s\n' invalid || printf '%s\n' withdrawn
}

reconcile_control() {
	service=$1
	state=$2
	changed=$3
	command -v systemctl >/dev/null 2>&1 || fail "systemctl is required for SD-WAN reconciliation"
	case "$service" in
		candy-sdwan.service|candy-server.service) ;;
		*) fail "unsupported SD-WAN reconciliation service: $service" ;;
	esac
	acted=0
	case "$state" in
		withdrawn|invalid)
			if [ "$service" = candy-server.service ]; then
				if systemctl is-active --quiet "$service"; then
					if [ "$changed" = 1 ]; then
						systemctl restart "$service"
						acted=1
					fi
				else
					systemctl start "$service"
					acted=1
				fi
			else
				if systemctl is-active --quiet "$service"; then
					systemctl stop "$service"
					acted=1
				fi
			fi
			if [ "$acted" = 1 ] || [ "$changed" = 1 ]; then
				case "$state" in
					withdrawn) reason="Cloud SD-WAN candidate withdrawn" ;;
					*) reason="Invalid Cloud SD-WAN candidate pointer" ;;
				esac
				write_status "$(current_registration_state)" fail-open "$reason"
			fi
			;;
		rejected:*)
			if [ "$service" = candy-server.service ]; then
				if ! systemctl is-active --quiet "$service"; then
					systemctl start "$service"
					acted=1
				fi
			else
				if systemctl is-active --quiet "$service"; then
					systemctl stop "$service"
					acted=1
				fi
			fi
			if [ "$acted" = 1 ] || [ "$changed" = 1 ]; then
				write_status "$(current_registration_state)" fail-open "Cloud SD-WAN candidate rejected"
			fi
			;;
		*)
			if systemctl is-active --quiet "$service"; then
				if [ "$changed" = 1 ]; then
					systemctl restart "$service"
					acted=1
				fi
			else
				systemctl start "$service"
				acted=1
			fi
			if [ "$acted" = 1 ]; then
				write_status "$(current_registration_state)" reconnecting "Cloud SD-WAN candidate changed"
			fi
			;;
	esac
}

reconcile_sdwan() {
	require_root
	[ "$#" -eq 1 ] || fail "reconcile requires a systemd service name"
	service=$1
	ensure_directories
	state=$(candidate_reconcile_state)
	previous=$(read_reconcile_marker 2>/dev/null || true)
	if [ -z "$previous" ] && [ "$state" = withdrawn ]; then
		reconcile_control "$service" "$state" 0
		atomic_from_stdin "$reconcile_marker" 0600 <<EOF
$state
EOF
		delegate_state
		printf '%s\n' "SD-WAN reconciliation initialized without a candidate; service state verified."
		return 0
	fi
	changed=0
	if [ "$state" != "$previous" ]; then
		changed=1
		printf '%s\n' "SD-WAN reconciliation target changed: ${previous:-none} -> $state"
	fi
	reconcile_control "$service" "$state" "$changed"
	if [ "$changed" = 1 ]; then
		atomic_from_stdin "$reconcile_marker" 0600 <<EOF
$state
EOF
	fi
	delegate_state
}

usage() {
	cat <<'EOF'
usage: candy-sdwan-runtime ACTION [arguments]

Runtime internal actions:
  bootstrap BOOTSTRAP_FILE
  reconnect
  leave
  fail-open [REASON]
  running
  stopped
  publish
  reconcile SERVICE
  status
EOF
}

action=${1:-}
[ "$#" -eq 0 ] || shift
case "$action" in
	bootstrap)
		require_root
		[ "$#" -eq 1 ] || fail "bootstrap requires one bootstrap file"
		validate_bootstrap_file "$1"
		ensure_directories
		[ -x "$enrollment_client" ] || fail "Cloud enrollment client is not installed"
		[ "$(current_registration_state)" != registered ] || fail "this node is already registered; leave the Cloud before replacing its identity"
		bootstrap_file=$1
		cloud=$(sed -n 's/^.*"cloud_address"[[:space:]]*:[[:space:]]*"\([^"\\]*\)".*$/\1/p' "$bootstrap_file")
		validate_cloud_address "$cloud"
		audit_event join started "Cloud enrollment started"
		write_config "$cloud" join-pending
		write_status join-pending stopped ""
		delegate_state
		output_file=$(mktemp "$run_dir/.candy-enrollment.XXXXXX") || fail "could not create enrollment result file"
		trap 'rm -f "$output_file"; delegate_state >/dev/null 2>&1 || true' EXIT HUP INT TERM
		set -- "$enrollment_client" --state-dir "$enrollment_dir" --bootstrap-file "$bootstrap_file" --expected-platform "$enrollment_platform"
		if [ -n "$enrollment_architecture" ]; then
			set -- "$@" --expected-architecture "$enrollment_architecture"
		fi
		if [ -n "${CANDY_CLOUD_CA_CERTIFICATE:-}" ]; then
			set -- "$@" --ca-certificate "$CANDY_CLOUD_CA_CERTIFICATE"
		fi
		if "$@" >"$output_file"; then
			write_config "$cloud" registered
			write_status registered stopped ""
			delegate_state
			audit_event join completed "Cloud enrollment completed"
			if [ -x "$cloud_sync_init" ]; then
				"$cloud_sync_init" enable >/dev/null 2>&1 || true
				"$cloud_sync_init" restart >/dev/null 2>&1 || true
			elif command -v systemctl >/dev/null 2>&1; then
				systemctl enable --now candy-cloud-sync.timer >/dev/null 2>&1 || true
				systemctl start candy-cloud-sync.service >/dev/null 2>&1 || true
			fi
			cat "$output_file"
			rm -f "$output_file"
			trap - EXIT HUP INT TERM
		else
			write_status join-pending stopped "Cloud bootstrap failed; retry candy bootstrap with the same file to resume the same installation"
			delegate_state
			audit_event join failed "Cloud enrollment failed"
			rm -f "$output_file"
			trap - EXIT HUP INT TERM
			fail "Cloud bootstrap failed; existing network state was not changed"
		fi
		;;
	reconnect)
		require_root
		ensure_directories
		state=$(current_registration_state)
		[ "$state" != unregistered ] || fail "this node has not joined a Cloud"
		audit_event reconnect requested "SD-WAN reconnect requested"
		write_status "$state" reconnecting ""
		delegate_state
		;;
	leave)
		require_root
		ensure_directories
		audit_event leave started "Local Cloud identity removal started"
		if [ -x "$cloud_sync_init" ]; then
			"$cloud_sync_init" stop >/dev/null 2>&1 || true
			"$cloud_sync_init" disable >/dev/null 2>&1 || true
		elif command -v systemctl >/dev/null 2>&1; then
			systemctl stop candy-cloud-sync.timer candy-cloud-sync.service >/dev/null 2>&1 || true
		fi
		clear_state_path "$config_file"
		clear_enrollment_material
		for path in \
			"$state_dir/profile-v1.json" \
			"$state_dir/sync-state-v1.json" \
			"$state_dir/cloud-sync-status-v1.json" \
			"$state_dir/transport-identity-state-v1.json" \
			"$state_dir/activation-ready-v1.json" \
			"$state_dir/reconcile-target-v1" \
			"$state_dir/candidate" \
			"$state_dir/active" \
			"$state_dir/configuration" \
			"$state_dir/activations" \
			"$state_dir/generations" \
			"$state_dir/grants"; do
			clear_state_path "$path"
		done
		write_status unregistered stopped ""
		audit_event leave completed "Local Cloud identity removed"
		delegate_state
		;;
	fail-open)
		require_root
		ensure_directories
		write_status "$(current_registration_state)" fail-open "${1:-Candy-owned network state removed}"
		delegate_state
		;;
	running)
		require_root
		ensure_directories
		write_status "$(current_registration_state)" running ""
		delegate_state
		;;
	stopped)
		require_root
		ensure_directories
		write_status "$(current_registration_state)" stopped ""
		delegate_state
		;;
	publish)
		require_root
		publish_status
		delegate_state
		;;
	status)
		show_status
		;;
	reconcile)
		reconcile_sdwan "$@"
		;;
	-h|--help|help)
		usage
		;;
	*)
		usage >&2
		exit 64
		;;
esac
