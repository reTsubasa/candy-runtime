[Unit]
Description=Candy client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/candy-client --config /etc/candy/client.toml
Restart=on-failure
RestartSec=2s
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/candy /var/lib/candy /run/candy

[Install]
WantedBy=multi-user.target
