[Unit]
Description=Candy Cloud configuration synchronization
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/candy/sdwan/identity/device-identity-v1.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/libexec/candy-cloud-sync sync-once
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/candy/sdwan /run/candy

