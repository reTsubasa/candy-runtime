[Unit]
Description=Candy Cloud configuration synchronization
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/candy/sdwan/identity/device-identity-v1.json

[Service]
Type=oneshot
User=candy-sdwan
Group=candy-sdwan
UMask=0077
Environment=CANDY_SDWAN_STATE_DIR=/var/lib/candy/sdwan
Environment=CANDY_SDWAN_STATE_ROOT=/var/lib/candy/sdwan
ExecStart=/usr/local/libexec/candy-cloud-sync --state-dir /var/lib/candy/sdwan sync-once
ExecStartPost=+/usr/local/libexec/candy-sdwan-runtime reconcile candy-sdwan.service
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/candy/sdwan /run/candy
