[Unit]
Description=Candy SD-WAN managed data plane
After=network-online.target candy-netd.service
Wants=network-online.target candy-netd.service
StartLimitIntervalSec=60s
StartLimitBurst=5
# netd owns persistent network infrastructure and may restart independently.
# The SD-WAN Agent must stay alive to observe/retry netd recovery; binding its
# unit lifecycle to netd would stop a healthy Agent and cascade a netd restart
# into the active domain. The candidate path remains required by the condition.
ConditionPathIsSymbolicLink=/var/lib/candy/sdwan/candidate

[Service]
Type=simple
UMask=0077
Environment=CANDY_SDWAN_READINESS_TIMEOUT_MS=20000
Environment=CANDY_NETD_SOCKET=/run/candy-netd/netd.sock
Environment=CANDY_CORE_BIN=/opt/candy/cores/current/candy-core
Environment=CANDY_SDWAN_ACTIVATION=/var/lib/candy/sdwan/candidate
Environment=CANDY_SDWAN_ACTIVATION_READY=/var/lib/candy/sdwan/activation-ready-v1.json
Environment=CANDY_SDWAN_LEASE_MS=30000
EnvironmentFile=-/etc/candy/sdwan-agent.env
ExecStartPre=+/usr/local/libexec/candy-sdwan-runtime publish
ExecStart=/usr/local/libexec/candy-sdwan-agent --socket ${CANDY_NETD_SOCKET} --core ${CANDY_CORE_BIN} --activation ${CANDY_SDWAN_ACTIVATION} --activation-ready ${CANDY_SDWAN_ACTIVATION_READY} --lease-ms ${CANDY_SDWAN_LEASE_MS} --readiness-timeout-ms ${CANDY_SDWAN_READINESS_TIMEOUT_MS} run
# The agent rolls back through netd before exit; this hook only publishes state.
ExecStopPost=+/usr/local/libexec/candy-sdwan-runtime fail-open service-stopped
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s
User=candy-sdwan
Group=candy-sdwan
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/candy /run/candy
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
