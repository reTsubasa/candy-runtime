# Optional overrides for /etc/candy/sdwan-agent.env. The service unit contains
# secure product defaults, so this file is only needed for a custom deployment.
CANDY_NETD_SOCKET=/run/candy-netd/netd.sock
CANDY_NETD_JOURNAL=/var/lib/candy/netd.journal
CANDY_CORE_BIN=/opt/candy/cores/current/candy-core
CANDY_SDWAN_ACTIVATION=/var/lib/candy/sdwan/candidate
CANDY_SDWAN_ACTIVATION_READY=/var/lib/candy/sdwan/activation-ready-v1.json
CANDY_SDWAN_LEASE_MS=30000
CANDY_SDWAN_READINESS_TIMEOUT_MS=20000
