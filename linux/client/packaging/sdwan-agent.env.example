# Copy to /etc/candy/sdwan-agent.env and replace all deployment-specific values.
# This file is intentionally not installed as an active configuration.
CANDY_NETD_SOCKET=/run/candy-netd/netd.sock
CANDY_NETD_JOURNAL=/var/lib/candy/netd.journal
CANDY_CORE_BIN=/opt/candy/cores/current/candy-core
CANDY_SDWAN_CORE_CONFIG=/var/lib/candy/sdwan/core.toml
CANDY_SDWAN_DECLARATION=/var/lib/candy/sdwan/declaration.json
CANDY_SDWAN_STATUS_FILE=/run/candy/sdwan-status.json
CANDY_SDWAN_INSTANCE_ID=00112233445566778899aabbccddeeff
CANDY_SDWAN_GENERATION=1
CANDY_SDWAN_LEASE_MS=30000
