#!/bin/sh
set -eu

readonly_runtime_api=1
core_root=${CANDY_CORE_ROOT:-/opt/candy/cores}
core_current=${CANDY_CORE_CURRENT_LINK:-$core_root/current}
core_candidate=${CANDY_CORE_BINARY:-$core_current/candy-core}
sdwan_runtime=${CANDY_SDWAN_RUNTIME:-/usr/local/libexec/candy-sdwan-runtime}
server_service=${CANDY_SERVER_SERVICE:-candy-server.service}
sdwan_agent=${CANDY_SDWAN_AGENT:-/usr/local/libexec/candy-sdwan-agent}
sdwan_state_root=${CANDY_SDWAN_STATE_ROOT:-${CANDY_SDWAN_STATE_DIR:-/var/lib/candy/sdwan}}
sdwan_candidate=${CANDY_SDWAN_ACTIVATION_LINK:-$sdwan_state_root/candidate}
activation_ready=${CANDY_SDWAN_ACTIVATION_READY:-$sdwan_state_root/activation-ready-v1.json}
netd_socket=${CANDY_NETD_SOCKET:-/run/candy-netd/netd.sock}
sdwan_history_retain=${CANDY_SDWAN_HISTORY_RETAIN:-4}
export CANDY_SDWAN_STATE_DIR="$sdwan_state_root"
export CANDY_SDWAN_STATE_ROOT="$sdwan_state_root"
export CANDY_SDWAN_SERVICE_USER="${CANDY_SDWAN_SERVICE_USER:-candy}"
export CANDY_SDWAN_SERVICE_GROUP="${CANDY_SDWAN_SERVICE_GROUP:-candy}"

fail() {
	status=$1
	shift
	printf '%s\n' "candy-server: $*" >&2
	exit "$status"
}

require_sdwan_runtime() {
	[ -x "$sdwan_runtime" ] || fail 69 "SD-WAN Runtime is not installed"
}

warn() {
	printf '%s\n' "candy-server: warning: $*" >&2
}

valid_history_name() {
	name=$1
	case "$name" in
		????????????????????????????????????????????????????????????????)
			case "$name" in *[!0-9a-f]*) return 1 ;; esac
			;;
		legacy-????????-????-????-????-????????????)
			legacy_id=${name#legacy-}
			case "$legacy_id" in *[!0-9a-f-]*) return 1 ;; esac
			;;
		*) return 1 ;;
	esac
}

protected_history_names() {
	collection=$1
	protected=
	for pointer in configuration candidate active; do
		[ -L "$sdwan_state_root/$pointer" ] || continue
		target=$(readlink "$sdwan_state_root/$pointer" 2>/dev/null || true)
		case "$target" in
			"$collection"/*)
				name=${target#"$collection"/}
				valid_history_name "$name" || continue
				case " $protected " in *" $name "*) ;; *) protected="$protected $name" ;; esac
				;;
		esac
	done
	printf '%s\n' "$protected"
}

prune_history_collection() {
	collection=$1
	directory=$sdwan_state_root/$collection
	[ -e "$directory" ] || [ -L "$directory" ] || return 0
	[ -d "$directory" ] && [ ! -L "$directory" ] ||
		fail 78 "SD-WAN $collection history must be a real directory"
	directory_real=$(CDPATH= cd -P -- "$directory" 2>/dev/null && pwd -P) ||
		fail 78 "cannot resolve SD-WAN $collection history"
	[ "$directory_real" = "$state_root_real/$collection" ] ||
		fail 78 "SD-WAN $collection history escaped the state root"

	protected=$(protected_history_names "$collection")
	protected_count=0
	for name in $protected; do protected_count=$((protected_count + 1)); done
	available=$((sdwan_history_retain - protected_count))
	[ "$available" -ge 0 ] || available=0
	kept=0

	# Runtime-generated names contain no whitespace. Sorting by mtime preserves
	# the newest rollback material while pointer targets are always retained.
	for path in $(LC_ALL=C ls -1dt "$directory"/* 2>/dev/null || true); do
		name=${path##*/}
		if ! valid_history_name "$name"; then
			warn "ignored unexpected SD-WAN $collection history entry: $path"
			continue
		fi
		if [ -L "$path" ] || [ ! -d "$path" ]; then
			warn "ignored non-directory SD-WAN $collection history entry: $path"
			continue
		fi
		case " $protected " in *" $name "*) continue ;; esac
		if [ "$kept" -lt "$available" ]; then
			kept=$((kept + 1))
			continue
		fi
		find "$path" -xdev -type d -exec chmod u+w {} \; ||
			fail 77 "could not make stale SD-WAN $collection history removable: $path"
		rm -rf "$path" || fail 77 "could not remove stale SD-WAN $collection history: $path"
	done
}

prune_sdwan_history() {
	case "$sdwan_history_retain" in ''|*[!0-9]*) fail 64 "CANDY_SDWAN_HISTORY_RETAIN must be an integer" ;; esac
	[ "$sdwan_history_retain" -ge 2 ] && [ "$sdwan_history_retain" -le 32 ] ||
		fail 64 "CANDY_SDWAN_HISTORY_RETAIN must be between 2 and 32"
	[ -d "$sdwan_state_root" ] && [ ! -L "$sdwan_state_root" ] ||
		fail 78 "SD-WAN state root must be a real directory"
	state_root_real=$(CDPATH= cd -P -- "$sdwan_state_root" 2>/dev/null && pwd -P) ||
		fail 78 "cannot resolve SD-WAN state root"
	prune_history_collection generations
	prune_history_collection activations
}

canonical_file() {
	path=$1
	hops=0
	while [ -L "$path" ]; do
		[ "$hops" -lt 40 ] || return 1
		target=$(readlink "$path" 2>/dev/null) || return 1
		case "$target" in
			/*) path=$target ;;
			*) path=$(dirname -- "$path")/$target ;;
		esac
		hops=$((hops + 1))
	done
	parent=$(CDPATH= cd -P -- "$(dirname -- "$path")" 2>/dev/null && pwd -P) || return 1
	printf '%s/%s\n' "$parent" "$(basename -- "$path")"
}

resolve_server_activation() {
	[ -L "$sdwan_candidate" ] || return 1
	candidate_target=$(readlink "$sdwan_candidate" 2>/dev/null) || return 1
	case "$candidate_target" in
		activations/*) ;;
		*) return 1 ;;
	esac
	activation_id=${candidate_target#activations/}
	[ "${#activation_id}" -eq 64 ] || return 1
	case "$activation_id" in *[!0-9a-f]*) return 1 ;; esac
	[ -d "$sdwan_state_root" ] && [ ! -L "$sdwan_state_root" ] || return 1
	state_root_real=$(CDPATH= cd -P -- "$sdwan_state_root" 2>/dev/null && pwd -P) || return 1
	candidate_parent=$(CDPATH= cd -P -- "$(dirname -- "$sdwan_candidate")" 2>/dev/null && pwd -P) || return 1
	[ "$candidate_parent" = "$state_root_real" ] || return 1
	[ -d "$state_root_real/activations" ] && [ ! -L "$state_root_real/activations" ] || return 1
	activation_directory=$state_root_real/activations/$activation_id
	[ -d "$activation_directory" ] && [ ! -L "$activation_directory" ] || return 1
	activation_descriptor=$candidate_parent/$(basename -- "$sdwan_candidate")/activation-v1.json
	[ -f "$activation_descriptor" ] && [ ! -L "$activation_descriptor" ] || return 1
	printf '%s\n' "$activation_descriptor"
}

activation_was_rejected() {
	[ -f "$activation_ready" ] && [ ! -L "$activation_ready" ] || return 1
	bytes=$(wc -c <"$activation_ready" | tr -d ' ')
	[ "$bytes" -gt 0 ] && [ "$bytes" -le 65536 ] || return 1
	target=$(readlink "$sdwan_candidate" 2>/dev/null) || return 1
	activation_id=${target#activations/}
	grep -F "\"activation_id\":\"$activation_id\"" "$activation_ready" >/dev/null &&
		grep -F '"state":"rejected"' "$activation_ready" >/dev/null
}

node_usage() {
	cat <<'EOF'
usage:
  candy-server bootstrap FILE
  candy-server sdwan status
  candy-server sdwan reconnect
  candy-server sdwan prune-history
  candy-server leave [--yes]
  candy-server [server options]
EOF
}

case "${1:-}" in
	join)
		node_usage >&2
		fail 64 "node enrollment uses a short-lived Bootstrap file: candy-server bootstrap FILE"
		;;
	bootstrap)
		shift
		[ "$#" -eq 1 ] || fail 64 "bootstrap requires one bootstrap file"
		[ "$(id -u)" = 0 ] || fail 77 "bootstrap requires root privileges"
		[ -f "$1" ] && [ ! -L "$1" ] || fail 66 "bootstrap input must be a regular file"
		chmod 0600 "$1" || fail 77 "could not protect the bootstrap file"
		require_sdwan_runtime
		"$sdwan_runtime" bootstrap "$1"
		printf '%s\n' "This server has joined Candy Cloud. Its existing Candy service remains unchanged until an authorized SD-WAN configuration is available."
		exit 0
		;;
	sdwan)
		shift
		subcommand=${1:-}
		[ "$#" -eq 0 ] || shift
		[ "$#" -eq 0 ] || fail 64 "unexpected SD-WAN argument: $1"
		case "$subcommand" in
			status)
				require_sdwan_runtime
				"$sdwan_runtime" status
				;;
			reconnect)
				require_sdwan_runtime
				[ "$(id -u)" = 0 ] || fail 77 "reconnect requires root privileges"
				"$sdwan_runtime" reconnect
				if command -v systemctl >/dev/null 2>&1 && systemctl restart "$server_service"; then
					printf '%s\n' "SD-WAN reconnect requested."
				else
					"$sdwan_runtime" fail-open "reconnect failed; Candy-owned network state removed" || true
					fail 1 "reconnect failed; the network was restored to the Candy-stopped state"
				fi
				;;
			prune-history)
				[ "$(id -u)" = 0 ] || [ "${CANDY_SDWAN_TEST_MODE:-0}" = 1 ] ||
					fail 77 "SD-WAN history pruning requires root privileges"
				prune_sdwan_history
				;;
			*) node_usage >&2; exit 64 ;;
		esac
		exit 0
		;;
	leave)
		shift
		[ "$(id -u)" = 0 ] || fail 77 "leave requires root privileges"
		confirmed=0
		case "${1:-}" in --yes) confirmed=1; shift ;; '') ;; *) fail 64 "unknown leave option: $1" ;; esac
		[ "$#" -eq 0 ] || fail 64 "unexpected leave argument: $1"
		if [ "$confirmed" -ne 1 ]; then
			[ -t 0 ] || fail 64 "leave requires --yes when input is not interactive"
			printf '%s' "Leave Candy Cloud and remove local SD-WAN enrollment intent? [y/N] " >&2
			read -r answer
			case "$answer" in y|Y|yes|YES) ;; *) exit 1 ;; esac
		fi
		require_sdwan_runtime
		"$sdwan_runtime" fail-open "node left Candy Cloud"
		"$sdwan_runtime" leave
		if command -v systemctl >/dev/null 2>&1; then
			systemctl try-restart "$server_service" 2>/dev/null || true
		fi
		printf '%s\n' "This server has left Candy Cloud. Its ordinary Candy service was not changed."
		exit 0
		;;
	-h|--help|help)
		node_usage
		exit 0
		;;
esac

command -v readlink >/dev/null 2>&1 ||
	fail 69 "cannot resolve the managed data plane: required command 'readlink' is missing"

[ -e "$core_candidate" ] ||
	fail 69 "the managed data plane is not installed or active"
[ -f "$core_candidate" ] && [ -x "$core_candidate" ] ||
	fail 69 "the managed data plane is invalid"

core_binary=$(canonical_file "$core_candidate") ||
	fail 69 "cannot resolve the managed data plane"
[ -n "$core_binary" ] && [ -f "$core_binary" ] && [ -x "$core_binary" ] ||
	fail 69 "the managed data plane is not executable"

launcher_binary=$(canonical_file "$0" 2>/dev/null || true)
[ -z "$launcher_binary" ] || [ "$core_binary" != "$launcher_binary" ] ||
	fail 78 "the managed data-plane selection points back to candy-server"

if core_api=$("$core_binary" runtime-api-version); then
	:
else
	status=$?
	fail 69 "managed data-plane inspection failed with exit code $status"
fi
[ "$core_api" = "$readonly_runtime_api" ] ||
	fail 78 "incompatible managed data-plane process API '$core_api'; this Runtime requires process API $readonly_runtime_api"

export CANDY_RUNTIME_PROCESS_API_VERSION=$readonly_runtime_api
export CANDY_RUNTIME_ROLE=server

# Only the service's canonical run shape may consume an authenticated
# activation. Diagnostics and manually supplied server options always remain
# side-effect free at this boundary.
ordinary_config=
if [ "$#" -eq 2 ] && [ "$1" = --config ]; then
	ordinary_config=$2
elif [ "$#" -eq 1 ]; then
	case "$1" in --config=*) ordinary_config=${1#--config=} ;; esac
fi

if [ -n "$ordinary_config" ] && [ -e "$sdwan_candidate" ]; then
	if activation=$(resolve_server_activation); then
		if activation_was_rejected; then
			warn "the current server SD-WAN activation was already rejected; starting ordinary Candy only"
		elif [ -x "$sdwan_agent" ]; then
			if "$sdwan_agent" validate-activation \
				--activation "$activation" \
				--expected-core-role server \
				--ordinary-config "$ordinary_config"
			then
				exec "$sdwan_agent" \
					--activation "$activation" \
					--activation-ready "$activation_ready" \
					--core "$core_binary" \
					--ordinary-config "$ordinary_config" \
					--socket "$netd_socket" \
					run
			fi
			warn "rejected an invalid server SD-WAN activation; starting ordinary Candy only"
		else
			warn "authenticated SD-WAN activation is present but the transaction agent is unavailable; starting ordinary Candy only"
		fi
	else
		warn "ignored an invalid SD-WAN activation pointer; starting ordinary Candy only"
	fi
fi

# Ordinary Candy and optional SD-WAN are always owned by one Core server
# process. After an SD-WAN activation failure the agent supervises an
# ordinary-config child only after rolling back Candy-owned state.
exec "$core_binary" server "$@"
