#!/bin/sh

set -u

CORE_ROOT=${CANDY_CORE_ROOT:-/usr/lib/candy/cores}
CURRENT_LINK=${CANDY_CORE_CURRENT_LINK:-$CORE_ROOT/current}
PREVIOUS_LINK=${CANDY_CORE_PREVIOUS_LINK:-$CORE_ROOT/previous}
SERVICE_INIT=${CANDY_SERVICE_INIT:-/etc/init.d/candy}
SIGNATURE_VERIFIER=${CANDY_CORE_SIGNATURE_VERIFIER:-}
CORE_SIGNING_KEY=${CANDY_CORE_SIGNING_KEY:-/usr/share/candy/keys/core-release.pub}
HEALTH_CHECK=${CANDY_RUNTIME_HEALTH_CHECK:-/usr/libexec/candy-runtime-health-check}
EXPECTED_PROCESS_API=${CANDY_EXPECTED_CORE_PROCESS_API:-1}
EXPECTED_CORE_API=${CANDY_EXPECTED_CORE_API:-1}
MAX_CORE_BYTES=${CANDY_MAX_CORE_BYTES:-134217728}
MAX_MANIFEST_BYTES=${CANDY_MAX_MANIFEST_BYTES:-262144}
BUNDLE_SHA_FILE=.bundle.sha256
LOCK_DIR=${CANDY_CORE_LOCK_DIR:-/var/lock/candy-core-manager.lock}
SERVICE_LOCK_DIR=${CANDY_SERVICE_LOCK_DIR:-/var/lib/candy/service.lock}
PROC_ROOT=${CANDY_PROC_ROOT:-/proc}
OPERATION_FILE=${CANDY_CORE_OPERATION_FILE:-/tmp/candy-core-operation.json}
HEALTH_WAIT_SECONDS=${CANDY_CORE_HEALTH_WAIT_SECONDS:-15}
OPERATION_ACTION=
OPERATION_VERSION=
VALIDATION_PHASE=
VALIDATION_CODE=
VALIDATION_DETAIL=
LOCAL_UPLOAD_COPY=
SERVICE_LOCK_HELD=0

json_string() {
	printf '"'
	printf '%s' "$1" | awk '
		NR > 1 { printf "\\n" }
		{
			gsub(/\\/, "\\\\")
			gsub(/"/, "\\\"")
			gsub(/\t/, "\\t")
			gsub(/\r/, "\\r")
			printf "%s", $0
		}
	'
	printf '"'
}

write_operation() {
	local state="$1" message="$2" phase="${3:-}" error_code="${4:-}" detail="${5:-}" temporary
	[ -n "$OPERATION_ACTION" ] || return 0
	mkdir -p "$(dirname "$OPERATION_FILE")" || return 0
	temporary="$OPERATION_FILE.tmp.$$"
	{
		printf '{"schema_version":2,"state":'
		json_string "$state"
		printf ',"action":'
		json_string "$OPERATION_ACTION"
		printf ',"version":'
		json_string "$OPERATION_VERSION"
		printf ',"message":'
		json_string "$message"
		printf ',"phase":'
		json_string "$phase"
		printf ',"error_code":'
		json_string "$error_code"
		printf ',"detail":'
		json_string "$detail"
		printf ',"updated_at":%s}\n' "$(date +%s 2>/dev/null || printf 0)"
	} > "$temporary" && chmod 0600 "$temporary" && mv -f "$temporary" "$OPERATION_FILE"
}

fail() {
	fail_stage manager operation_failed "$*"
}

fail_stage() {
	local phase="$1" code="$2"
	shift 2
	write_operation error "$*" "$phase" "$code" "$*" || true
	log_event error core_operation "$phase" "$code" "$*"
	printf '%s\n' "$*" >&2
	exit 1
}

log_event() {
	local level="$1" event="$2" phase="$3" code="$4"
	shift 4
	if command -v logger >/dev/null 2>&1; then
		logger -t candy -- "level=$level event=$event pid=$$ action=${OPERATION_ACTION:-none} version=${OPERATION_VERSION:-unknown} phase=$phase code=$code detail=$*"
	fi
}

validation_error() {
	VALIDATION_PHASE=$1
	VALIDATION_CODE=$2
	shift 2
	VALIDATION_DETAIL=$*
	printf '%s\n' "$VALIDATION_DETAIL" >&2
	return 1
}

cleanup_operation_locks() {
	if [ "$SERVICE_LOCK_HELD" = 1 ]; then
		rm -f "$SERVICE_LOCK_DIR/pid" 2>/dev/null || true
		rmdir "$SERVICE_LOCK_DIR" 2>/dev/null || true
		SERVICE_LOCK_HELD=0
	fi
	rm -f "$LOCAL_UPLOAD_COPY" 2>/dev/null || true
	rm -f "$LOCK_DIR/pid" 2>/dev/null || true
	rmdir "$LOCK_DIR" 2>/dev/null || true
}

acquire_lock() {
	local lock_pid
	mkdir -p "$(dirname "$LOCK_DIR")" || return 1
	if ! mkdir "$LOCK_DIR" 2>/dev/null; then
		lock_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
		case "$lock_pid" in
			''|*[!0-9]*) return 1 ;;
		esac
		kill -0 "$lock_pid" 2>/dev/null && return 1
		rm -f "$LOCK_DIR/pid" 2>/dev/null || return 1
		rmdir "$LOCK_DIR" 2>/dev/null || return 1
		mkdir "$LOCK_DIR" 2>/dev/null || return 1
	fi
	printf '%s\n' "$$" > "$LOCK_DIR/pid" || { rmdir "$LOCK_DIR" 2>/dev/null || true; return 1; }
	trap 'cleanup_operation_locks' EXIT HUP INT TERM
}

acquire_service_lifecycle_lock() {
	mkdir -p "$(dirname "$SERVICE_LOCK_DIR")" || return 1
	mkdir "$SERVICE_LOCK_DIR" 2>/dev/null || return 1
	SERVICE_LOCK_HELD=1
	if ! chmod 0700 "$SERVICE_LOCK_DIR" 2>/dev/null ||
		! printf '%s\n' "$$" > "$SERVICE_LOCK_DIR/pid"; then
		rm -f "$SERVICE_LOCK_DIR/pid" 2>/dev/null || true
		rmdir "$SERVICE_LOCK_DIR" 2>/dev/null || true
		SERVICE_LOCK_HELD=0
		return 1
	fi
}

valid_version() {
	printf '%s' "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+([+.-][0-9A-Za-z][0-9A-Za-z.+-]*)?$'
}

host_arch_matches() {
	local target_arch="$1" host_arch distro_arch
	host_arch=$(uname -m 2>/dev/null || true)
	case "$host_arch:$target_arch" in
		x86_64:x86_64|amd64:x86_64|aarch64:aarch64|arm64:aarch64|arm*:arm|arm*:armv7|arm*:armv7l)
			return 0
		;;
	esac
	# On OpenWrt, DISTRIB_ARCH describes the package ABI and can be more
	# specific than uname(1), e.g. arm_cortex-a7_neon-vfpv4 on IPQ40xx.
	distro_arch=$(sed -n "s/^DISTRIB_ARCH='\([^']*\)'/\1/p; s/^DISTRIB_ARCH=\"\([^\"]*\)\"/\1/p" /etc/openwrt_release 2>/dev/null | head -1)
	case "$distro_arch:$target_arch" in
		x86_64:x86_64|aarch64:aarch64|arm_cortex-a7_neon-vfpv4:arm|arm_cortex-a7_neon-vfpv4:armv7|arm_cortex_a7_neon_vfpv4:arm|arm_cortex_a7_neon_vfpv4:armv7)
			return 0
		;;
		*)
			printf '%s' "${distro_arch:-${host_arch:-unknown}}" >&2
			return 1
		;;
	esac
}

valid_sha256() {
	printf '%s' "$1" | grep -Eq '^[0-9a-fA-F]{64}$'
}

version_path() {
	valid_version "$1" || return 1
	printf '%s/%s' "$CORE_ROOT" "$1"
}

link_version() {
	local target
	target=$(readlink "$1" 2>/dev/null || true)
	[ -n "$target" ] || return 0
	basename "$target"
}

atomic_link() {
	local link="$1" version="$2" temporary
	valid_version "$version" || return 1
	temporary="$link.tmp.$$"
	rm -f "$temporary"
	ln -s "$version" "$temporary" || return 1
	if mv -fT "$temporary" "$link" 2>/dev/null; then
		return 0
	fi
	rm -f "$link" || return 1
	mv -f "$temporary" "$link"
}

restore_link() {
	local link="$1" version="$2"
	if [ -n "$version" ]; then
		atomic_link "$link" "$version"
	else
		rm -f "$link"
	fi
}

manifest_field() {
	jsonfilter -i "$1" -e "$2" 2>/dev/null || true
}

manifest_size_ok() {
	local size
	size=$(wc -c < "$1" 2>/dev/null | tr -d ' ' || printf 0)
	case "$size" in ''|*[!0-9]*) return 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_MANIFEST_BYTES" ]
}

validate_manifest_file() {
	local manifest="$1" expected_version="$2" schema process_api core_schema api version core_target_os core_target_arch target_os target_arch libc executable executable_sha
	[ -f "$manifest" ] && [ ! -L "$manifest" ] && manifest_size_ok "$manifest" || validation_error manifest manifest_missing "Core manifest is missing, unsafe, or oversized" || return 1
	schema=$(manifest_field "$manifest" '@.schema_version')
	process_api=$(manifest_field "$manifest" '@.process_api_version')
	core_schema=$(manifest_field "$manifest" '@.core.schema_version')
	api=$(manifest_field "$manifest" '@.core.core_api_version')
	version=$(manifest_field "$manifest" '@.core.core_version')
	core_target_os=$(manifest_field "$manifest" '@.core.target_os')
	core_target_arch=$(manifest_field "$manifest" '@.core.target_arch')
	target_os=$(manifest_field "$manifest" '@.artifact.target_os')
	target_arch=$(manifest_field "$manifest" '@.artifact.target_arch')
	libc=$(manifest_field "$manifest" '@.artifact.libc')
	executable=$(manifest_field "$manifest" '@.artifact.executable')
	executable_sha=$(manifest_field "$manifest" '@.artifact.executable_sha256')
	[ "$schema" = 1 ] || validation_error manifest schema_incompatible "Core manifest schema ${schema:-missing} is not supported" || return 1
	[ "$process_api" = "$EXPECTED_PROCESS_API" ] || validation_error manifest process_api_incompatible "Core process API ${process_api:-missing} is not compatible with required API $EXPECTED_PROCESS_API" || return 1
	[ "$core_schema" = 1 ] || validation_error manifest core_schema_incompatible "Core schema ${core_schema:-missing} is not supported" || return 1
	[ "$api" = "$EXPECTED_CORE_API" ] || validation_error manifest core_api_incompatible "Core API ${api:-missing} is not compatible with required API $EXPECTED_CORE_API" || return 1
	[ "$version" = "$expected_version" ] || validation_error manifest version_mismatch "Core version ${version:-missing} does not match requested version $expected_version" || return 1
	[ "$target_os" = linux ] || validation_error manifest os_incompatible "Core target OS ${target_os:-missing} is not supported" || return 1
	[ "$core_target_os" = "$target_os" ] || validation_error manifest os_mismatch "Core and artifact target OS values do not match" || return 1
	[ "$core_target_arch" = "$target_arch" ] || validation_error manifest arch_mismatch "Core and artifact target architecture values do not match" || return 1
	[ "$libc" = musl ] || validation_error manifest libc_incompatible "Core libc ${libc:-missing} is not compatible with OpenWrt" || return 1
	[ -n "$target_arch" ] || validation_error manifest arch_missing "Core target architecture is missing" || return 1
	host_arch_matches "$target_arch" || {
		validation_error manifest arch_incompatible "Core target architecture $target_arch does not match $(uname -m 2>/dev/null || printf unknown)" || return 1
	}
	[ "$executable" = candy-core ] || validation_error manifest executable_path_invalid "Core executable path is invalid" || return 1
	valid_sha256 "$executable_sha" || validation_error manifest executable_sha_invalid "Core executable SHA-256 is invalid" || return 1
}

verify_manifest_signature() {
	local manifest="$1" signature="$2"
	if [ -n "$SIGNATURE_VERIFIER" ]; then
		[ -x "$SIGNATURE_VERIFIER" ] || validation_error signature verifier_unavailable "Core signature verifier is unavailable" || return 1
		"$SIGNATURE_VERIFIER" "$manifest" "$signature" || validation_error signature signature_invalid "Core manifest signature is invalid" || return 1
		return 0
	fi
	command -v usign >/dev/null 2>&1 || validation_error signature verifier_unavailable "usign is unavailable" || return 1
	[ -f "$CORE_SIGNING_KEY" ] && [ ! -L "$CORE_SIGNING_KEY" ] || validation_error signature signing_key_missing "Core signing key is unavailable" || return 1
	usign -V -p "$CORE_SIGNING_KEY" -m "$manifest" -x "$signature" >/dev/null 2>&1 || validation_error signature signature_invalid "Core manifest signature is invalid" || return 1
}

validate_core_directory() {
	local directory="$1" expected_version="$2" executable="$1/candy-core" manifest="$1/manifest.json" signature="$1/manifest.sig" info="$1/manifest.runtime.json" expected_executable_sha actual_executable_sha process_api info_schema info_process_api info_api info_version expected_target_os expected_target_arch info_target_os info_target_arch
	VALIDATION_PHASE= VALIDATION_CODE= VALIDATION_DETAIL=
	[ -f "$manifest" ] && [ ! -L "$manifest" ] || validation_error archive manifest_missing "Core bundle does not contain a regular manifest.json" || return 1
	[ -f "$signature" ] && [ ! -L "$signature" ] || validation_error archive signature_missing "Core bundle does not contain a regular manifest.sig" || return 1
	[ -f "$executable" ] && [ -x "$executable" ] && [ ! -L "$executable" ] || validation_error archive executable_missing "Core bundle does not contain an executable candy-core" || return 1
	validate_manifest_file "$manifest" "$expected_version" || return 1
	verify_manifest_signature "$manifest" "$signature" || return 1
	expected_executable_sha=$(manifest_field "$manifest" '@.artifact.executable_sha256' | tr 'A-F' 'a-f')
	actual_executable_sha=$(sha256sum "$executable" 2>/dev/null | awk '{ print tolower($1) }')
	[ "$actual_executable_sha" = "$expected_executable_sha" ] || validation_error executable executable_sha_mismatch "Core executable SHA-256 does not match the signed manifest" || return 1
	if command -v timeout >/dev/null 2>&1; then
		process_api=$(timeout 10 "$executable" runtime-api-version 2>/dev/null) || validation_error process_probe runtime_api_probe_failed "Core runtime API probe failed" || return 1
	else
		process_api=$("$executable" runtime-api-version 2>/dev/null) || validation_error process_probe runtime_api_probe_failed "Core runtime API probe failed" || return 1
	fi
	[ "$process_api" = "$EXPECTED_PROCESS_API" ] || validation_error process_probe runtime_api_incompatible "Core executable process API ${process_api:-missing} is incompatible" || return 1
	rm -f "$info"
	if command -v timeout >/dev/null 2>&1; then
		timeout 10 "$executable" core-info > "$info" 2>/dev/null || validation_error process_probe core_info_probe_failed "Core information probe failed" || return 1
	else
		"$executable" core-info > "$info" 2>/dev/null || validation_error process_probe core_info_probe_failed "Core information probe failed" || return 1
	fi
	[ -f "$info" ] && manifest_size_ok "$info" || validation_error process_probe core_info_invalid "Core information response is missing or oversized" || return 1
	info_schema=$(manifest_field "$info" '@.schema_version')
	info_process_api=$(manifest_field "$info" '@.process_api_version')
	info_api=$(manifest_field "$info" '@.core_api_version')
	info_version=$(manifest_field "$info" '@.core_version')
	expected_target_os=$(manifest_field "$manifest" '@.artifact.target_os')
	expected_target_arch=$(manifest_field "$manifest" '@.artifact.target_arch')
	info_target_os=$(manifest_field "$info" '@.target_os')
	info_target_arch=$(manifest_field "$info" '@.target_arch')
	[ "$info_schema" = 1 ] || validation_error process_probe core_info_schema_invalid "Core process returned an unsupported information schema" || return 1
	[ "$info_process_api" = "$EXPECTED_PROCESS_API" ] || validation_error process_probe runtime_api_incompatible "Core process returned an incompatible process API" || return 1
	[ "$info_api" = "$EXPECTED_CORE_API" ] || validation_error process_probe core_api_incompatible "Core process returned an incompatible Core API" || return 1
	[ "$info_version" = "$expected_version" ] || validation_error process_probe version_mismatch "Core process returned a different version" || return 1
	[ "$info_target_os" = "$expected_target_os" ] || validation_error process_probe os_mismatch "Core process returned a different target OS" || return 1
	[ "$info_target_arch" = "$expected_target_arch" ] || validation_error process_probe arch_mismatch "Core process returned a different target architecture" || return 1
	rm -f "$info"
}

managed_core_directory() {
	local directory="$1" version="$2"
	validate_manifest_file "$directory/manifest.json" "$version" 2>/dev/null || return 1
	[ -f "$directory/manifest.sig" ] && [ ! -L "$directory/manifest.sig" ] || return 1
	[ -f "$directory/candy-core" ] && [ -x "$directory/candy-core" ] && [ ! -L "$directory/candy-core" ] || return 1
}

download_bundle() {
	local url="$1" destination="$2" source
	case "$url" in
		https://*) ;;
		file://*)
			[ "${CANDY_CORE_ALLOW_FILE_URL:-0}" = 1 ] || return 1
			source=${url#file://}
			case "$source" in /*) ;; *) return 1 ;; esac
			[ -s "$source" ] && [ -f "$source" ] && [ ! -L "$source" ] || return 1
			cp "$source" "$destination"
			return $?
			;;
		*) return 1 ;;
	esac
	if command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q -O "$destination" "$url"
	elif command -v wget >/dev/null 2>&1; then
		wget -q -O "$destination" "$url"
	elif command -v curl >/dev/null 2>&1; then
		curl -fsSL --proto '=https,file' --max-time 180 -o "$destination" "$url"
	else
		return 1
	fi
}

safe_archive() {
	local archive="$1"
	tar -tzf "$archive" 2>/dev/null | awk '
		BEGIN { ok = 1; count = 0 }
		{
			name = $0
			gsub(/^\.\//, "", name)
			if (name != "manifest.json" && name != "manifest.sig" && name != "candy-core") ok = 0
			seen[name]++
			count++
		}
		END {
			if (count != 3 || seen["manifest.json"] != 1 || seen["manifest.sig"] != 1 || seen["candy-core"] != 1) ok = 0
			exit ok ? 0 : 1
		}
	' || return 1
	tar -tvzf "$archive" 2>/dev/null | awk '
		BEGIN { ok = 1; count = 0 }
		{
			if (substr($0, 1, 1) != "-") ok = 0
			count++
		}
		END { exit (ok && count == 3) ? 0 : 1 }
	'
}

inspect_local_bundle() {
	local source="$1" probe size version
	case "$source" in /*) ;; *) validation_error upload upload_path_invalid "Uploaded Core path is invalid" || return 1 ;; esac
	[ -s "$source" ] && [ -f "$source" ] && [ ! -L "$source" ] || validation_error upload upload_file_invalid "Uploaded Core is not a regular file" || return 1
	size=$(wc -c < "$source" 2>/dev/null | tr -d ' ' || printf 0)
	case "$size" in ''|*[!0-9]*) validation_error upload upload_size_invalid "Uploaded Core size is invalid" || return 1 ;; esac
	[ "$size" -le "$MAX_CORE_BYTES" ] || validation_error upload upload_too_large "Uploaded Core exceeds the size limit" || return 1
	mkdir -p "$CORE_ROOT" || validation_error install core_root_unavailable "Cannot create the Core directory" || return 1
	[ ! -L "$CORE_ROOT" ] || validation_error install core_root_unsafe "Core root must not be a symbolic link" || return 1
	LOCAL_UPLOAD_COPY="$CORE_ROOT/.upload-$$.tar.gz"
	cp "$source" "$LOCAL_UPLOAD_COPY" && chmod 0600 "$LOCAL_UPLOAD_COPY" || validation_error upload upload_copy_failed "Cannot stage the uploaded Core" || return 1
	safe_archive "$LOCAL_UPLOAD_COPY" || validation_error archive archive_unsafe "Core bundle contains unsafe paths, entries, or file types" || return 1
	probe="$CORE_ROOT/.upload-inspect-$$"
	rm -rf "$probe"
	mkdir -m 0700 "$probe" || validation_error archive staging_failed "Cannot create Core inspection directory" || return 1
	if ! tar -xzf "$LOCAL_UPLOAD_COPY" -C "$probe"; then
		rm -rf "$probe"
		validation_error archive extraction_failed "Core bundle extraction failed" || return 1
	fi
	if find "$probe" ! -type f ! -type d -print 2>/dev/null | grep -q .; then
		rm -rf "$probe"
		validation_error archive archive_unsafe "Core bundle contains unsupported file types" || return 1
	fi
	[ -f "$probe/manifest.json" ] && [ ! -L "$probe/manifest.json" ] || { rm -rf "$probe"; validation_error archive manifest_missing "Core bundle does not contain a regular manifest.json" || return 1; }
	[ -f "$probe/manifest.sig" ] && [ ! -L "$probe/manifest.sig" ] || { rm -rf "$probe"; validation_error archive signature_missing "Core bundle does not contain a regular manifest.sig" || return 1; }
	verify_manifest_signature "$probe/manifest.json" "$probe/manifest.sig" || { rm -rf "$probe"; return 1; }
	version=$(manifest_field "$probe/manifest.json" '@.core.core_version')
	rm -rf "$probe"
	valid_version "$version" || validation_error manifest version_invalid "Signed Core manifest has an invalid version" || return 1
	OPERATION_VERSION=$version
}

install_core() {
	local version="$1" url="$2" expected_sha="$3" temporary archive destination size actual_sha current previous existing=0 installed_sha
	valid_version "$version" || fail_stage request version_invalid "Invalid Core version"
	valid_sha256 "$expected_sha" || fail_stage request sha_invalid "Invalid Core SHA-256"
	destination=$(version_path "$version") || fail_stage request version_invalid "Invalid Core version"
	if [ -e "$destination" ] || [ -L "$destination" ]; then
		[ -d "$destination" ] && [ ! -L "$destination" ] || fail_stage install destination_unsafe "Core $version has an unsafe existing path"
		current=$(link_version "$CURRENT_LINK")
		previous=$(link_version "$PREVIOUS_LINK")
		[ "$version" != "$previous" ] || [ "$version" = "$current" ] || fail_stage install rollback_replace_rejected "Core $version is the rollback Core and cannot be replaced"
		existing=1
	fi
	mkdir -p "$CORE_ROOT" || fail_stage install core_root_unavailable "Cannot create the Core directory"
	[ ! -L "$CORE_ROOT" ] || fail_stage install core_root_unsafe "Core root must not be a symbolic link"
	temporary="$CORE_ROOT/.install-$version-$$"
	archive="$temporary/core.tar.gz"
	rm -rf "$temporary"
	mkdir -m 0700 "$temporary" || fail_stage install staging_failed "Cannot create the Core staging directory"
	download_bundle "$url" "$archive" || {
		rm -rf "$temporary"
		fail_stage download download_failed "Core bundle download failed"
	}
	size=$(wc -c < "$archive" 2>/dev/null | tr -d ' ' || printf 0)
	case "$size" in ''|*[!0-9]*) rm -rf "$temporary"; fail_stage download size_invalid "Core bundle size is invalid" ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_CORE_BYTES" ] || {
		rm -rf "$temporary"
		fail_stage download size_limit_exceeded "Core bundle exceeds the size limit"
	}
	actual_sha=$(sha256sum "$archive" 2>/dev/null | awk '{ print tolower($1) }')
	[ "$actual_sha" = "$(printf '%s' "$expected_sha" | tr 'A-F' 'a-f')" ] || {
		rm -rf "$temporary"
		fail_stage download sha_mismatch "Core bundle SHA-256 does not match the signed catalog"
	}
	safe_archive "$archive" || {
		rm -rf "$temporary"
		fail_stage archive archive_unsafe "Core bundle contains unsafe paths, entries, or file types"
	}
	tar -xzf "$archive" -C "$temporary" || {
		rm -rf "$temporary"
		fail_stage archive extraction_failed "Core bundle extraction failed"
	}
	rm -f "$archive"
	if find "$temporary" ! -type f ! -type d -print 2>/dev/null | grep -q .; then
		rm -rf "$temporary"
		fail_stage archive archive_unsafe "Core bundle contains unsupported file types"
	fi
	validate_core_directory "$temporary" "$version" || {
		rm -rf "$temporary"
		fail_stage "${VALIDATION_PHASE:-validation}" "${VALIDATION_CODE:-validation_failed}" "${VALIDATION_DETAIL:-Core bundle validation failed}"
	}
	# Core verification runs as root, while Cloud synchronization executes the
	# active binary as the unprivileged candy-sdwan user.
	chmod 0755 "$temporary" || {
		rm -rf "$temporary"
		fail_stage install permission_failed "Cannot make the verified Core available to Runtime services"
	}
	actual_sha=$(printf '%s' "$expected_sha" | tr 'A-F' 'a-f')
	if ! printf '%s\n' "$actual_sha" >"$temporary/$BUNDLE_SHA_FILE" ||
		! chmod 0644 "$temporary/$BUNDLE_SHA_FILE"; then
		rm -rf "$temporary"
		fail_stage install identity_store_failed "Cannot store the verified Core bundle identity"
	fi
	if [ "$existing" = 1 ]; then
		installed_sha=$(cat "$destination/$BUNDLE_SHA_FILE" 2>/dev/null || true)
		if [ "$installed_sha" = "$actual_sha" ]; then
			rm -rf "$temporary"
			printf '%s\n' "Core $version bundle is already installed"
			return 0
		fi
		replace_installed_core "$version" "$temporary" "$destination" "$current"
		return 0
	fi
	mv "$temporary" "$destination" || {
		rm -rf "$temporary"
		fail_stage install install_failed "Cannot install Core bundle"
	}
	log_event info core_installed install installed "Installed Core $version without activation"
	printf '%s\n' "installed Core $version"
}

install_local_core() {
	local source="$1" sha
	inspect_local_bundle "$source" || fail_stage "${VALIDATION_PHASE:-upload}" "${VALIDATION_CODE:-upload_invalid}" "${VALIDATION_DETAIL:-Uploaded Core validation failed}"
	sha=$(sha256sum "$LOCAL_UPLOAD_COPY" 2>/dev/null | awk '{ print tolower($1) }')
	valid_sha256 "$sha" || fail_stage upload sha_failed "Cannot calculate the uploaded Core SHA-256"
	CANDY_CORE_ALLOW_FILE_URL=1 install_core "$OPERATION_VERSION" "file://$LOCAL_UPLOAD_COPY" "$sha"
	rm -f "$LOCAL_UPLOAD_COPY"
	LOCAL_UPLOAD_COPY=
}

service_running() {
	[ -x "$SERVICE_INIT" ] && "$SERVICE_INIT" status >/dev/null 2>&1
}

core_directory_in_use() {
	local directory="$1" physical_directory executable target
	physical_directory=$(CDPATH= cd "$directory" 2>/dev/null && pwd -P) || physical_directory=$directory
	for executable in "$PROC_ROOT"/[0-9]*/exe; do
		[ -L "$executable" ] || continue
		target=$(readlink "$executable" 2>/dev/null || true)
		case "$target" in
			"$directory/candy-core"|"$directory/candy-core (deleted)"|"$physical_directory/candy-core"|"$physical_directory/candy-core (deleted)")
				return 0
			;;
		esac
	done
	return 1
}

restart_if_running() {
	local waited=0 state
	[ "$1" = 1 ] || return 0
	"$SERVICE_INIT" restart || return 1
	while [ "$waited" -lt "$HEALTH_WAIT_SECONDS" ]; do
		state=$("$SERVICE_INIT" status 2>/dev/null || true)
		if [ "$state" = running ] && [ -x "$HEALTH_CHECK" ] && "$HEALTH_CHECK" client >/dev/null 2>&1; then
			return 0
		fi
		waited=$((waited + 1))
		sleep 1
	done
	return 1
}

replace_installed_core() {
	local version="$1" candidate="$2" destination="$3" current="$4" backup was_running=0 waited=0
	if [ "$current" = "$version" ]; then
		acquire_service_lifecycle_lock || {
			rm -rf "$candidate"
			fail_stage install service_lock_busy "Another Candy service lifecycle action is running"
		}
		service_running && was_running=1
		if [ "$was_running" = 1 ] && ! "$SERVICE_INIT" stop; then
			rm -rf "$candidate"
			fail_stage install service_stop_failed "Cannot stop Candy for active Core replacement"
		fi
		while core_directory_in_use "$destination" && [ "$waited" -lt "$HEALTH_WAIT_SECONDS" ]; do
			waited=$((waited + 1))
			sleep 1
		done
		if core_directory_in_use "$destination"; then
			restart_if_running "$was_running" || true
			rm -rf "$candidate"
			fail_stage install core_still_running "The active Core process did not stop"
		fi
	fi
	backup="$CORE_ROOT/.replace-$version-$$"
	[ ! -e "$backup" ] && [ ! -L "$backup" ] || {
		restart_if_running "$was_running" || true
		rm -rf "$candidate"
		fail_stage install replacement_backup_unsafe "Core replacement backup path is unsafe"
	}
	mv "$destination" "$backup" || {
		restart_if_running "$was_running" || true
		rm -rf "$candidate"
		fail_stage install replacement_stage_failed "Cannot preserve installed Core $version"
	}
	if ! mv "$candidate" "$destination"; then
		mv "$backup" "$destination" 2>/dev/null || true
		restart_if_running "$was_running" || true
		fail_stage install replacement_failed "Cannot install replacement Core bundle"
	fi
	if ! restart_if_running "$was_running"; then
		"$SERVICE_INIT" stop >/dev/null 2>&1 || true
		rm -rf "$destination"
		mv "$backup" "$destination" || fail_stage rollback replacement_restore_failed "Replacement Core failed and the previous directory could not be restored"
		restart_if_running "$was_running" || true
		fail_stage health replacement_health_failed "Replacement Core failed its health check; previous Core restored"
	fi
	rm -rf "$backup"
	if [ "$current" = "$version" ]; then
		log_event info core_installed install active_replaced "Replaced active Core $version"
		printf '%s\n' "replaced active Core $version"
	else
		log_event info core_installed install inactive_replaced "Replaced inactive Core $version"
		printf '%s\n' "replaced inactive Core $version"
	fi
}

activate_core() {
	local version="$1" directory old old_previous was_running=0
	directory=$(version_path "$version") || fail "invalid Core version"
	[ -d "$directory" ] || fail "Core $version is not installed"
	validate_core_directory "$directory" "$version" || fail_stage "${VALIDATION_PHASE:-validation}" "${VALIDATION_CODE:-validation_failed}" "${VALIDATION_DETAIL:-Core validation failed}"
	old=$(link_version "$CURRENT_LINK")
	old_previous=$(link_version "$PREVIOUS_LINK")
	[ "$old" != "$version" ] || { printf '%s\n' "Core $version is already active"; return 0; }
	service_running && was_running=1
	[ -z "$old" ] || atomic_link "$PREVIOUS_LINK" "$old" || fail "cannot preserve previous Core"
	atomic_link "$CURRENT_LINK" "$version" || {
		restore_link "$PREVIOUS_LINK" "$old_previous" || true
		fail "cannot activate Core"
	}
	if ! restart_if_running "$was_running"; then
		restore_link "$CURRENT_LINK" "$old" || true
		restore_link "$PREVIOUS_LINK" "$old_previous" || true
		restart_if_running "$was_running" || true
		fail "Core health check failed; previous Core restored"
	fi
	log_event info core_activated activate activated "Activated Core $version"
	printf '%s\n' "activated Core $version"
}

rollback_core() {
	local current previous was_running=0
	current=$(link_version "$CURRENT_LINK")
	previous=$(link_version "$PREVIOUS_LINK")
	[ -n "$previous" ] || fail "no previous Core is available"
	validate_core_directory "$CORE_ROOT/$previous" "$previous" || fail_stage "${VALIDATION_PHASE:-validation}" "${VALIDATION_CODE:-validation_failed}" "${VALIDATION_DETAIL:-Previous Core validation failed}"
	service_running && was_running=1
	atomic_link "$CURRENT_LINK" "$previous" || fail "cannot activate previous Core"
	if ! restore_link "$PREVIOUS_LINK" "$current"; then
		restore_link "$CURRENT_LINK" "$current" || true
		restore_link "$PREVIOUS_LINK" "$previous" || true
		fail "cannot preserve current Core as rollback version"
	fi
	if ! restart_if_running "$was_running"; then
		restore_link "$CURRENT_LINK" "$current" || true
		restore_link "$PREVIOUS_LINK" "$previous" || true
		restart_if_running "$was_running" || true
		fail "rollback health check failed; original Core restored"
	fi
	log_event warn core_rollback rollback rolled_back "Rolled back from ${current:-none} to $previous"
	printf '%s\n' "rolled back to Core $previous"
}

remove_core() {
	local version="$1" directory current previous removing_current=0 removing_previous=0
	directory=$(version_path "$version") || fail "invalid Core version"
	current=$(link_version "$CURRENT_LINK")
	previous=$(link_version "$PREVIOUS_LINK")
	[ -d "$directory" ] || fail "Core $version is not installed"
	[ ! -L "$directory" ] || fail "Core $version directory is unsafe"
	if [ "$version" = "$current" ]; then
		acquire_service_lifecycle_lock || fail "another Candy service lifecycle action is running"
		service_running && fail "stop Candy before removing the current Core"
		core_directory_in_use "$directory" && fail "Core $version is still in use by a running process"
		removing_current=1
	fi
	[ "$version" != "$previous" ] || removing_previous=1
	if { [ "$removing_current" = 0 ] || restore_link "$CURRENT_LINK" ""; } &&
		{ [ "$removing_previous" = 0 ] || restore_link "$PREVIOUS_LINK" ""; }; then
		:
	else
		restore_link "$CURRENT_LINK" "$current" || true
		restore_link "$PREVIOUS_LINK" "$previous" || true
		fail "cannot detach Core $version"
	fi
	if ! rm -rf "$directory" || [ -e "$directory" ]; then
		restore_link "$CURRENT_LINK" "$current" || true
		restore_link "$PREVIOUS_LINK" "$previous" || true
		fail "cannot remove Core $version"
	fi
	log_event info core_removed install removed "Removed Core $version"
	printf '%s\n' "removed Core $version"
}

status_json() {
	local current previous manifest first=1 directory version bundle_sha current_bundle_sha
	current=$(link_version "$CURRENT_LINK")
	previous=$(link_version "$PREVIOUS_LINK")
	printf '{"schema_version":1,"manager_api_version":1,"required_core_process_api_version":%s,"required_core_api_version":%s,"service_running":' "$EXPECTED_PROCESS_API" "$EXPECTED_CORE_API"
	service_running && printf true || printf false
	if [ -n "$current" ]; then printf ',"current_version":"%s"' "$current"; else printf ',"current_version":null'; fi
	current_bundle_sha=$(cat "$CORE_ROOT/$current/$BUNDLE_SHA_FILE" 2>/dev/null || true)
	printf ',"current_bundle_sha256":'
	if valid_sha256 "$current_bundle_sha"; then json_string "$current_bundle_sha"; else printf null; fi
	if [ -n "$previous" ]; then printf ',"previous_version":"%s"' "$previous"; else printf ',"previous_version":null'; fi
	manifest="$CORE_ROOT/$current/manifest.json"
	if [ -n "$current" ] && validate_manifest_file "$manifest" "$current" 2>/dev/null; then printf ',"current_manifest":'; cat "$manifest"; else printf ',"current_manifest":null'; fi
	if [ -f "$OPERATION_FILE" ] && manifest_size_ok "$OPERATION_FILE"; then
		case "$(manifest_field "$OPERATION_FILE" '@.state')" in
			running|completed|error) printf ',"operation":'; cat "$OPERATION_FILE" ;;
			*) printf ',"operation":null' ;;
		esac
	else
		printf ',"operation":null'
	fi
	printf ',"installed":['
	for directory in "$CORE_ROOT"/*; do
		[ -d "$directory" ] && [ ! -L "$directory" ] || continue
		version=$(basename "$directory")
		valid_version "$version" || continue
		[ "$first" = 1 ] || printf ','
		first=0
		printf '{"version":"%s","active":' "$version"
		[ "$version" = "$current" ] && printf true || printf false
		printf ',"rollback":'; [ "$version" = "$previous" ] && printf true || printf false
		printf ',"managed":'; managed_core_directory "$directory" "$version" && printf true || printf false
		bundle_sha=$(cat "$directory/$BUNDLE_SHA_FILE" 2>/dev/null || true)
		printf ',"bundle_sha256":'
		if valid_sha256 "$bundle_sha"; then json_string "$bundle_sha"; else printf null; fi
		printf '}'
	done
	printf ']}\n'
}

command=${1:-status}
case "$command" in
	status|list) status_json ;;
	install) [ "$#" -eq 4 ] || fail "usage: $0 install VERSION URL SHA256"; acquire_lock || fail "another Core operation is running"; OPERATION_ACTION=install; OPERATION_VERSION=$2; write_operation running "downloading and validating Core bundle" download; install_core "$2" "$3" "$4"; write_operation completed "Core $2 was installed" install ;;
	install-local) [ "$#" -eq 2 ] || fail "usage: $0 install-local FILE"; acquire_lock || fail "another Core operation is running"; OPERATION_ACTION=install-local; write_operation running "validating uploaded Core bundle" upload; install_local_core "$2"; write_operation completed "Core $OPERATION_VERSION was installed" install ;;
	activate) [ "$#" -eq 2 ] || fail "usage: $0 activate VERSION"; acquire_lock || fail "another Core operation is running"; OPERATION_ACTION=activate; OPERATION_VERSION=$2; write_operation running "validating and activating Core"; activate_core "$2"; write_operation completed "Core $2 is active" ;;
	rollback) [ "$#" -eq 1 ] || fail "usage: $0 rollback"; acquire_lock || fail "another Core operation is running"; OPERATION_ACTION=rollback; OPERATION_VERSION=$(link_version "$PREVIOUS_LINK"); write_operation running "activating the previous Core"; rollback_core; write_operation completed "Core $OPERATION_VERSION is active" ;;
	remove) [ "$#" -eq 2 ] || fail "usage: $0 remove VERSION"; acquire_lock || fail "another Core operation is running"; OPERATION_ACTION=remove; OPERATION_VERSION=$2; write_operation running "removing Core"; remove_core "$2"; write_operation completed "Core $2 was removed" ;;
	*) fail "unknown Core manager command" ;;
esac
