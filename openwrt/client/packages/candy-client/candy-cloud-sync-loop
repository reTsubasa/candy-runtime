#!/bin/sh

set -u

SYNC_BIN=${CANDY_CLOUD_SYNC_BIN:-/usr/libexec/candy-cloud-sync}
STATE_DIR=${CANDY_SDWAN_STATE_DIR:-/etc/candy/sdwan}
IDENTITY_FILE=${CANDY_CLOUD_IDENTITY_FILE:-$STATE_DIR/identity/device-identity-v1.json}
INTERVAL=${CANDY_CLOUD_SYNC_INTERVAL:-1}
RUN_USER=${CANDY_CLOUD_SYNC_USER:-candy-sdwan}
CANDY_INIT=${CANDY_INIT:-/etc/init.d/candy}
CANDY_CORE_BIN=${CANDY_CORE_BIN:-/usr/lib/candy/cores/current/candy-core}
FAULT_STATE_FILE=${CANDY_FAULT_STATE_FILE:-/etc/candy/runtime-fault.json}
CANDY_LIFECYCLE_FILE=${CANDY_LIFECYCLE_FILE:-/tmp/candy.lifecycle}
CANDY_LIFECYCLE_TTL_SECONDS=${CANDY_LIFECYCLE_TTL_SECONDS:-10}
MAX_ERROR_BACKOFF=${CANDY_CLOUD_SYNC_MAX_ERROR_BACKOFF:-60}

completed_runtime_fault() {
	[ -s "$FAULT_STATE_FILE" ] && [ -f "$FAULT_STATE_FILE" ] && [ ! -L "$FAULT_STATE_FILE" ] || return 1
	[ "$(jsonfilter -e '@.schema_version' <"$FAULT_STATE_FILE" 2>/dev/null)" = 1 ] || return 1
	[ "$(jsonfilter -e '@.state' <"$FAULT_STATE_FILE" 2>/dev/null)" = active ] || return 1
	[ "$(jsonfilter -e '@.cleanup' <"$FAULT_STATE_FILE" 2>/dev/null)" = completed ]
}

current_lifecycle_transition() {
	[ -s "$CANDY_LIFECYCLE_FILE" ] && [ -f "$CANDY_LIFECYCLE_FILE" ] && [ ! -L "$CANDY_LIFECYCLE_FILE" ] || return 1
	state=$(sed -n 's/.*"state":"\([^"]*\)".*/\1/p' "$CANDY_LIFECYCLE_FILE" | head -n1)
	updated_at=$(sed -n 's/.*"updated_at":\([0-9][0-9]*\).*/\1/p' "$CANDY_LIFECYCLE_FILE" | head -n1)
	case "$state" in starting|stopping) ;; *) return 1 ;; esac
	case "$updated_at" in ''|*[!0-9]*) return 1 ;; esac
	now=$(date +%s 2>/dev/null || true)
	case "$now" in ''|*[!0-9]*) return 1 ;; esac
	age=$((now - updated_at))
	[ "$age" -ge 0 ] && [ "$age" -le "$CANDY_LIFECYCLE_TTL_SECONDS" ] || return 1
	printf '%s\n' "$state"
}

reconcile_sdwan() {
	if ! "$CANDY_INIT" enabled >/dev/null 2>&1; then
		logger -t candy -- "level=info event=cloud_sync_reconcile result=deferred reason=service_disabled"
		return 0
	fi
	transition=$(current_lifecycle_transition 2>/dev/null || true)
	if [ -n "$transition" ]; then
		logger -t candy -- "level=info event=cloud_sync_reconcile result=deferred reason=service_$transition"
		return 0
	fi
	service_state=$("$CANDY_INIT" status 2>/dev/null || true)
	case "$service_state" in
		stopped)
			if completed_runtime_fault; then
				logger -t candy -- "level=warn event=cloud_sync_reconcile result=deferred reason=runtime_fault"
				return 0
			fi
			if "$CANDY_INIT" start >/dev/null 2>&1; then
				logger -t candy -- "level=info event=cloud_sync_reconcile result=recovered reason=service_stopped"
				return 0
			fi
			logger -t candy -- "level=error event=cloud_sync_reconcile result=failed reason=service_restart_failed"
			return 1
			;;
		starting|stopping)
			logger -t candy -- "level=info event=cloud_sync_reconcile result=deferred reason=service_$service_state"
			return 0
			;;
	esac
	if "$CANDY_INIT" sdwan_reconcile >/dev/null 2>&1; then
		logger -t candy -- "level=info event=cloud_sync_reconcile result=ok"
		return 0
	fi
	logger -t candy -- "level=error event=cloud_sync_reconcile result=failed reason=activation_rejected"
	return 1
}

identity_available() {
	[ -s "$IDENTITY_FILE" ] && [ -f "$IDENTITY_FILE" ] && [ ! -L "$IDENTITY_FILE" ]
}

sync_state_from_stdout() {
	json=$(printf '%s\n' "$1" | awk 'NF { value = $0 } END { print value }')
	[ -n "$json" ] || return 1
	[ "$(printf '%s' "$json" | jsonfilter -e '@.schema_version' 2>/dev/null)" = 1 ] || return 1
	printf '%s' "$json" | jsonfilter -e '@.state' 2>/dev/null
}

case "$INTERVAL" in ''|*[!0-9]*|0) INTERVAL=1 ;; esac
case "$CANDY_LIFECYCLE_TTL_SECONDS" in ''|*[!0-9]*) CANDY_LIFECYCLE_TTL_SECONDS=10 ;; esac
case "$MAX_ERROR_BACKOFF" in ''|*[!0-9]*|0) MAX_ERROR_BACKOFF=60 ;; esac
[ -x "$SYNC_BIN" ] || exit 1
[ -x "$CANDY_INIT" ] || exit 1
command -v start-stop-daemon >/dev/null 2>&1 || exit 1
[ "$(id -u 2>/dev/null || printf 1)" = 0 ] || exit 1

trap 'exit 0' TERM INT
backoff=0
while identity_available; do
	# stdout is the machine-readable result channel. stderr remains attached to
	# procd so Runtime diagnostics stay visible without entering state parsing.
	if output=$(start-stop-daemon -S -c "$RUN_USER" -x "$SYNC_BIN" -- --state-dir "$STATE_DIR" --core "$CANDY_CORE_BIN" sync-once); then
		backoff=0
		state=$(sync_state_from_stdout "$output" || true)
		case "$state" in
			waiting_for_network_configuration|configuration_unchanged|configuration_updated|activation_pending|activation_rejected) ;;
			*) state=unknown ;;
		esac
		logger -t candy -- "level=info event=cloud_sync result=ok state=$state"
		reconcile_sdwan || true
		if ! "$CANDY_INIT" sdwan_prune_history >/dev/null 2>&1; then
			logger -t candy -- "level=warn event=cloud_sync_history result=failed"
		fi
	else
		rc=$?
		detail=$(printf '%s' "$output" | tr '\r\n' '  ' | cut -c 1-384)
		logger -t candy -- "level=warn event=cloud_sync result=failed exit=$rc activation=unchanged detail=$detail"
		if [ "$backoff" -eq 0 ]; then backoff=2; else backoff=$((backoff * 2)); fi
		[ "$backoff" -le "$MAX_ERROR_BACKOFF" ] || backoff="$MAX_ERROR_BACKOFF"
	fi
	if [ "$backoff" -gt "$INTERVAL" ]; then sleep "$backoff"; else sleep "$INTERVAL"; fi
done
