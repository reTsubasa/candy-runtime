config candy 'client'
	option enabled '0'
	option mode 'rule'
	option runtime_mode 'fallback'
	option dns_remote '0'
	option dns_mode 'smart'
	option dns_split '1'
	option dns_unknown_strategy 'parallel-validate'
	option dns_answer_geo_validate '1'
	option dns_domestic_resolvers 'system,223.5.5.5:53,119.29.29.29:53'
	option dns_foreign_strategy 'through-selected-node'
	option dns_egress_resolver '8.8.8.8:53'
	option dns_bootstrap_resolvers 'system,223.5.5.5:53'
	option dns_cache '1'
	option dns_cache_max_entries '4096'
	option dns_bind_answers_to_route '1'
	option dns_ttl_cap_seconds '300'
	option dns_negative_ttl_seconds '60'
	option dns_capture_lan '1'
	option filter_aaaa '1'
	option gfwlist_update_url 'https://raw.githubusercontent.com/gfwlist/gfwlist/master/gfwlist.txt'
	option gfwlist_auto_update '1'
	option gfwlist_update_interval_hours '24'
	option bypass_china_ip '1'
	option geo_update_url 'https://gaoyifan.github.io/china-operator-ip/china46.txt'
	option geo_auto_update '1'
	option geo_update_interval_hours '24'
	option performance_mode 'auto'
	option lanes 'auto'
	option congestion 'candy-bbr'
	option candy_bbr_preset 'current'
	option udp_client_multiplier '1'
	option udp_server_multiplier '1'
	option auto_firewall '1'
	option redirect_tcp '1'
	option redirect_udp '0'
	option block_quic '0'
	option transparent_tcp_port '12345'
	option transparent_udp_port '12346'
	option tproxy_mark '100'

# SD-WAN routes, Hub candidates, generations, and epochs are signed Cloud
# control objects. UCI intentionally cannot override them.
config sdwan 'sdwan'
	option enabled '0'
	option mode 'sdwan_tun'
	option netd_socket '/var/run/candy-netd/netd.sock'
	option netd_journal '/var/lib/candy/netd.journal'
	option epoch_directory '/var/lib/candy/epochs'

config node 'hk_1'
	# Bootstrap template only. A real node, pin, and credential must be provisioned
	# before enabling Candy; placeholder values are rejected by Core at startup.
	option enabled '0'
	option name 'hk-1'
	option key_id 'hk-1'
	option server ''
	option server_name ''
	option server_pin ''
	option auth ''
	option port_hopping_interval_seconds '300'
	# list port_hopping_port '10443'

config group 'Proxy'
	option type 'fallback'
	list node 'hk_1'

config rule
	option value 'GEOIP,CN,DIRECT,no-resolve'

config rule
	option value 'MATCH,Proxy'
