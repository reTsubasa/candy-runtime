#!/bin/sh /etc/rc.common

START=94
STOP=11
USE_PROCD=1

SYNC_BIN=${CANDY_CLOUD_SYNC_BIN:-/usr/libexec/candy-cloud-sync}
STATE_DIR=${CANDY_SDWAN_STATE_DIR:-/var/lib/candy/sdwan}
IDENTITY_FILE=$STATE_DIR/identity/device-identity-v1.json
INTERVAL=${CANDY_CLOUD_SYNC_INTERVAL:-30}

run_sync_loop() {
	trap 'exit 0' TERM INT
	while [ -f "$IDENTITY_FILE" ] && [ ! -L "$IDENTITY_FILE" ]; do
		if output=$($SYNC_BIN --state-dir "$STATE_DIR" sync-once 2>&1); then
			logger -t candy -- "level=info event=cloud_sync result=ok detail=$output"
		else
			rc=$?
			logger -t candy -- "level=warn event=cloud_sync result=failed exit=$rc detail=$output"
		fi
		sleep "$INTERVAL"
	done
}

start_service() {
	[ -x "$SYNC_BIN" ] || return 0
	[ -f "$IDENTITY_FILE" ] && [ ! -L "$IDENTITY_FILE" ] || return 0
	case "$INTERVAL" in ''|*[!0-9]*|0) INTERVAL=30 ;; esac
	procd_open_instance
	procd_set_param command "$initscript" run_sync_loop
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger candy
}

